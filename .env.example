# Copy to .env (local) or set in Vercel → Settings → Environment Variables. Never commit .env.

# --- Supabase ---------------------------------------------------------------------
# Supabase → Project Settings → API Keys. Use a SECRET key (sb_secret_…), never the publishable one.
# Leave both empty to run on the built-in demo data (nothing is saved between restarts).
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# --- Special demo access ---------------------------------------------------------------
# One code that opens BOTH views (customer app + owner dashboard), with a bar to switch.
# When set, nothing is reachable without it. Share as: https://<site>/acesso/entrar?codigo=<code>
DEMO_ACCESS_CODE=""

# --- Owner dashboard (/painel) -------------------------------------------------------
# Access code for the owner. Without it the dashboard is open (shows a warning).
PAINEL_PASSCODE=""

# --- Final Finance -------------------------------------------------------------------
# Link for the "Feche o mês no Final Finance" button on /painel/financeiro. Empty = "em breve".
FINAL_FINANCE_URL=""
